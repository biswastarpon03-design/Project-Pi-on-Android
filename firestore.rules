rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidPostResponse(data, userId) {
      return data.userId is string &&
             data.userId == userId &&
             data.userId == request.auth.uid &&
             data.postId is string &&
             data.postId.size() >= 1 &&
             data.postId.size() <= 200 &&
             isValidId(data.postKey) &&
             data.questionExcerpt is string &&
             data.questionExcerpt.size() <= 300 &&
             data.answerText is string &&
             data.answerText.size() >= 1 &&
             data.answerText.size() <= 2000 &&
             data.platformSummary is string &&
             data.platformSummary.size() >= 1 &&
             data.platformSummary.size() <= 100 &&
             data.createdAt is timestamp &&
             data.createdAt <= request.time &&
             data.updatedAt is timestamp &&
             data.updatedAt <= request.time;
    }

    match /users/{userId}/responses/{responseId} {
      allow get: if isSignedIn() && request.auth.uid == userId && isValidId(responseId);
      allow list: if isSignedIn() && request.auth.uid == userId;

      allow create: if isSignedIn() &&
                       request.auth.uid == userId &&
                       isValidId(responseId) &&
                       incoming().keys().hasAll([
                         'userId',
                         'postId',
                         'postKey',
                         'questionExcerpt',
                         'answerText',
                         'platformSummary',
                         'createdAt',
                         'updatedAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'userId',
                         'postId',
                         'postKey',
                         'questionExcerpt',
                         'answerText',
                         'platformSummary',
                         'createdAt',
                         'updatedAt'
                       ]) &&
                       isValidPostResponse(incoming(), userId);

      allow update: if isSignedIn() &&
                       request.auth.uid == userId &&
                       isValidId(responseId) &&
                       isValidPostResponse(incoming(), userId) &&
                       incoming().userId == existing().userId &&
                       incoming().postId == existing().postId &&
                       incoming().postKey == existing().postKey &&
                       incoming().questionExcerpt == existing().questionExcerpt &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['answerText', 'updatedAt']);

      allow delete: if isSignedIn() && request.auth.uid == userId && isValidId(responseId);
    }
  }
}
